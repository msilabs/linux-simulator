<template>
    <main class="wrap">
        <section class="page-head">
            <h1>Linux, <span class="grad">নিজের হাতে</span> শিখুন</h1>
            <p>ব্রাউজারে নকল terminal। command চালান, প্রতিটার বাংলা ব্যাখ্যা পান, ভুল করলে Undo করুন। কিছু install করতে হয় না।</p>
        </section>

        <section class="card term-card" aria-label="Terminal">
            <div class="term" id="term">
                <div class="term-out" id="term-out" role="log" aria-live="polite"></div>
                <form class="term-form" id="term-form" autocomplete="off">
                    <label class="term-label" for="term-input">
                        <span class="prompt" id="term-prompt"></span>
                    </label>
                    <input id="term-input" class="term-input" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" aria-label="command লিখুন">
                </form>
            </div>
            <div class="term-running" id="term-running" hidden>
                <span><code id="running-name"></code> চলছে, শেষ হচ্ছে না।</span>
                <button class="btn small" type="button" id="btn-stop">Ctrl+C দিয়ে থামান</button>
            </div>
            <p class="term-notice" id="term-notice" hidden></p>
            <div class="term-actions">
                <button class="btn" type="button" id="btn-undo" disabled>Undo</button>
                <button class="btn" type="button" id="btn-reset">শুরু থেকে</button>
                <span class="term-hint">Tab = নাম পূরণ · ↑ ↓ = আগের command · Ctrl+L = পর্দা পরিষ্কার</span>
            </div>
            <noscript><p class="term-notice">এই simulator চালাতে JavaScript লাগে।</p></noscript>
        </section>
    </main>

    <div class="editor" id="editor" hidden role="dialog" aria-modal="true" aria-labelledby="editor-title">
        <div class="editor-box">
            <div class="editor-head">
                <strong id="editor-title"></strong>
                <span class="editor-state" id="editor-state"></span>
            </div>
            <textarea class="editor-text" id="editor-text" spellcheck="false" aria-label="ফাইলের লেখা"></textarea>
            <p class="term-notice" id="editor-error" hidden></p>
            <div class="editor-actions">
                <button class="btn primary" type="button" id="editor-save">সেভ (Ctrl+S)</button>
                <button class="btn" type="button" id="editor-cancel">বন্ধ করুন (Esc)</button>
            </div>
        </div>
    </div>
</template>
