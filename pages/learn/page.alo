<head>
    <title>Learn · {{ data.site.name }}</title>
    <meta name="description" content="Linux terminal বাংলায় শুরু থেকে শিখুন: {{ data.learn.length.toLocaleString('bn-BD') }}টা ছোট পাঠ, প্রতিটায় নিজে চালিয়ে দেখার terminal।">
    <meta property="og:title" content="Learn · {{ data.site.name }}">
    <meta property="og:description" content="Linux terminal বাংলায় শুরু থেকে শিখুন: {{ data.learn.length.toLocaleString('bn-BD') }}টা ছোট পাঠ, প্রতিটায় নিজে চালিয়ে দেখার terminal।">
</head>

<template>
<main class="wrap">
  <section class="page-head">
    <h1>Linux <span class="grad">শুরু থেকে শিখুন</span></h1>
    <p>{{ data.learn.length.toLocaleString('bn-BD') }}টা ছোট পাঠ, একটার পর একটা। প্রতিটায় ছোট terminal আছে, যেখানে নিজে command চালিয়ে দেখা যায়।</p>
    <a class="cta" href="/learn/{{ data.learn.find((l) => l.order === 1).slug }}/">প্রথম পাঠ শুরু করুন <span class="cta-arrow" aria-hidden="true">→</span></a>
  </section>

  <template for="stage in [{ name: 'শুরু', note: 'terminal, ফোল্ডারে চলাফেরা আর ফাইলের কাজ', from: 1, to: 6 }, { name: 'পরের ধাপ', note: 'খোঁজা, redirect আর pipe', from: 7, to: 12 }, { name: 'গভীরে', note: 'অধিকার, user, process আর shell সাজানো', from: 13, to: 99 }]">
    <section class="stage">
      <div class="stage-head">
        <h2 class="section-title">{{ stage.name }}</h2>
        <span class="stage-note">{{ stage.note }}</span>
      </div>
      <ol class="course">
        <template for="l in data.learn.filter((x) => x.order >= stage.from && x.order <= stage.to).toSorted((a, b) => a.order - b.order)">
          <li>
            <a class="card course-item" href="/learn/{{ l.slug }}/">
              <span class="num">{{ l.order.toLocaleString('bn-BD') }}</span>
              <span class="txt">
                <b>{{ l.title }}</b>
                <span>{{ l.summary }}</span>
              </span>
              <svg class="go" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </li>
        </template>
      </ol>
    </section>
  </template>
</main>
</template>
